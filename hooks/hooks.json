{
  "description": "cto-team: inside cto-team projects, block grep/findstr/Select-String and point to ripgrep",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/prefer-rg.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
